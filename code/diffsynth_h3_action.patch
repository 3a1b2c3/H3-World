+def _apply_action_film(h, a_scale, a_shift, v0, n_video, latent_t, frame_rows):
+    """Apply the action modulation to the video segment: h_v <- h_v * (1 + scale) + shift.
+
+    Only one thing differs from the old additive bias, but it's the
+    important one: scale is **multiplicative**, so the modulation changes
+    with h itself. An additive bias gives each key a fixed vector
+    independent of the picture, but the visual effect of "press D" depends
+    on the current heading and scene -- different samples need the bias to
+    point in different directions, and the gradients cancel each other out
+    (measured cosine between delta-W and W's own direction: only +0.064).
+
+    Broadcasts [latent_t, 1, C] to [latent_t, frame_rows, C] without
+    materializing the expanded tensor: at real sizes,
+    repeat_interleave would be 14430x5376 bf16 ~= 155 MB/layer x 50 layers.
+    """
+    video = h.narrow(0, v0, n_video).view(latent_t, frame_rows, -1)
+    video = video * (1.0 + a_scale.unsqueeze(1)) + a_shift.unsqueeze(1)
+    return torch.cat([
+        h.narrow(0, 0, v0),
+        video.reshape(n_video, -1),
+        h.narrow(0, v0 + n_video, h.shape[0] - v0 - n_video),
+    ], dim=0)
+
