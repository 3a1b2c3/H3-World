+def _build_action_block_masks(ann_rows, v0, fr, latent_t, cu_seqlens, seq_len, device,
+                              n_real=None):
+    """The hard binding mask for per-latent text conditioning.
+
+    Does exactly one thing: **makes annotation row k and every video row
+    outside frame k mutually invisible**. Everything else is untouched --
+    video x video, subject anchor x all video, annotation x annotation, and
+    annotation x first-frame cond all stay exactly as in the base model, so
+    removing the annotation rows recovers the original model precisely,
+    which is what makes the equivalence check in the mask probe valid.
+
+    Self-attention is permutation-equivariant, so simply adding 37
+    annotation rows to the sequence gives the model no way to know which
+    one belongs to which frame; position (the mirrored offset) is only a
+    soft bias, and this mask is what actually guarantees it architecturally.
+
+    The second thing this does is padding: `packed` pads the valid length
+    to a value shared across the whole dataset (otherwise flex_attention
+    recompiles every time the sequence length changes), so the pad rows
+    have to be masked out here -- they're zero vectors, and leaving them
+    unmasked would let them participate in the softmax and change its
+    denominator. A pad row is only allowed to see itself; otherwise it has
+    no visible key at all and softmax produces NaN.
+
+    ann_rows: [latent_t, 2], the (start, end) absolute row indices of each
+              annotation in the sequence.
+    n_real:   the real length before padding; None means no padding.
+    """
+    from torch.nn.attention.flex_attention import create_block_mask
+
+    masks = {}
+    bounds = cu_seqlens.tolist()
+    for start, stop in zip(bounds[:-1], bounds[1:]):
+        length = stop - start
+        if length <= 0:
+            continue
+        local_real = length if n_real is None else max(0, min(int(n_real) - start, length))
+        has_pad = local_real < length
+        buf = _mask_buffers(device, start, length)
+        ann, frm, lim = buf["ann"], buf["frm"], buf["lim"]
+        ann.fill_(-1)
+        frm.fill_(-1)
+        lim.fill_(local_real)
+
+        any_ann = False
+        for k in range(latent_t):
+            lo, hi = int(ann_rows[k, 0]) - start, int(ann_rows[k, 1]) - start
+            lo, hi = max(lo, 0), min(hi, length)
+            if hi > lo:
+                ann[lo:hi] = k
+                any_ann = True
+        vlo, vhi = v0 - start, v0 + latent_t * fr - start
+        if vhi > 0 and vlo < length:
+            lo, hi = max(vlo, 0), min(vhi, length)
+            idx = torch.arange(lo, hi, device=device)
+            frm[lo:hi] = ((idx + start - v0) // fr).to(torch.int32)
+        any_frm = bool(vhi > 0 and vlo < length)
+
+        if not (any_ann and any_frm) and not has_pad:
+            continue                      # this segment has nothing to bind and nothing to pad-mask
+
+        def mask_mod(b, h, q, kv, ann=ann, frm=frm, lim=lim):
+            aq, akv, fq, fkv = ann[q], ann[kv], frm[q], frm[kv]
+            # When an annotation row is the **key**, only two kinds of query
+            # can read it:
+            #   1) the same annotation's own rows (a sentence needs to
+            #      attend to itself internally)
+            #   2) the one video latent it's bound to
+            # Static text, the first-frame cond, audio, and **every other
+            # annotation row** can never read it.
+            #
+            # This is what makes it "directed": only the outgoing edges are
+            # blocked, not the incoming ones. An annotation row reading
+            # static text / cond / its own video is left alone -- that's
+            # information **flowing into** the annotation row, not a
+            # bypass A_j -> V_k, and it gives the action sentence scene
+            # grounding.
+            #
+            # With the outgoing edges blocked, it follows that any path
+            # from A_k to V_j (j != k) must pass through V_k first, i.e.
+            # V_k is a cut vertex between A_k and the rest of the sequence.
+            # "A_k never reads another A_j" is required for this to hold --
+            # otherwise A_j's content would flow into A_k first, and V_k
+            # reading A_k would be reading A_j too, and the cut-vertex
+            # property would break immediately.
+            same_ann = (aq >= 0) & (akv >= 0) & (aq == akv)
+            v_reads_own = (fq >= 0) & (akv >= 0) & (fq == akv)
+            leak_out = (akv >= 0) & ~same_ann & ~v_reads_own
+            # Incoming edges are unchanged: an annotation row only reads
+            # the one latent it's bound to, not any other latent.
+            leak_in = (aq >= 0) & (fkv >= 0) & (aq != fkv)
+            blocked = leak_out | leak_in
+            real = (q < lim) & (kv < lim)
+            return (q == kv) | (real & ~blocked)
+
+        masks[start] = create_block_mask(mask_mod, None, None, length, length, device=device)
+    return masks
+
