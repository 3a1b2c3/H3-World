+def _apply_action_film(h, a_scale, a_shift, v0, n_video, latent_t, frame_rows):
+    """把动作调制加到 video 段上：h_v <- h_v * (1 + scale) + shift。
+
+    与旧的加性 bias 的区别只有一处，但那一处是关键：scale 是**乘性**的，
+    调制效果随 h 本身变化。加性 bias 给每个键一个与画面内容无关的固定向量，
+    而"按 D 键"的视觉效果依赖当前朝向和场景——不同样本要求 bias 指向不同方向，
+    梯度会互相抵消（实测 ΔW 与 W 的方向余弦只有 +0.064）。
+
+    [latent_t, 1, C] 广播到 [latent_t, frame_rows, C]，不物化中间张量：
+    真实尺寸下 repeat_interleave 是 14430x5376 bf16 ≈ 155 MB/层 x 50 层。
+    """
+    video = h.narrow(0, v0, n_video).view(latent_t, frame_rows, -1)
+    video = video * (1.0 + a_scale.unsqueeze(1)) + a_shift.unsqueeze(1)
+    return torch.cat([
+        h.narrow(0, 0, v0),
+        video.reshape(n_video, -1),
+        h.narrow(0, v0 + n_video, h.shape[0] - v0 - n_video),
+    ], dim=0)
+
