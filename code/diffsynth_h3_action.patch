+#!/usr/bin/env python3
+"""Force training to actually load the v2 diffsynth, then hand control to
+the original train.py.
+
+Why this wrapper exists:
+
+  diffsynth is installed editable in this environment, which registers a
+  **MetaPathFinder** (_EditableFinder) at interpreter startup through a
+  .pth file in site-packages. Its MAPPING is hardcoded to the unmodified
+  checkout:
+
+      MAPPING = {'diffsynth': '.../DiffSynth-Studio-h3/diffsynth'}
+
+  sys.meta_path takes priority over sys.path, so **setting PYTHONPATH does
+  nothing** -- no matter what the cwd is or where PYTHONPATH points,
+  `import diffsynth` resolves to the unmodified package. And this fails
+  silently: training runs normally, just against the old code.
+
+  We hit this once already: the first attempt at training 7872_directed ran
+  for 5.2 hours (1997 steps) entirely against the old symmetric mask. The
+  logs, loss, and throughput all looked completely normal -- nothing
+  signaled the problem.
+
+Fix: before importing diffsynth, remove the editable finder and its path
+hook, insert the v2 repo root at the front of sys.path, then run the
+original train.py as __main__.
+"""
+from __future__ import annotations
+
+import runpy
+import sys
+from pathlib import Path
+
+V2_ROOT = Path(__file__).resolve().parents[3]          # .../DiffSynth-Studio-h3-v2
+
+sys.meta_path = [f for f in sys.meta_path if "Editable" not in type(f).__name__]
+sys.path_hooks = [h for h in sys.path_hooks
+                  if "Editable" not in getattr(h, "__name__", str(h))]
+sys.path_importer_cache.clear()
+sys.path.insert(0, str(V2_ROOT))
+
+# Hard verification: better to fail to start than to silently train the wrong code.
+import inspect  # noqa: E402
+
+import diffsynth.models.minimax_h3_dit as _dit  # noqa: E402
+import diffsynth.pipelines.minimax_h3_audio_video as _pipe  # noqa: E402
+
+_checks = [
+    ("diffsynth resolved from v2", "-v2/" in _dit.__file__, _dit.__file__),
+    ("directed attention mask present", "leak_out" in inspect.getsource(_dit._build_action_block_masks), ""),
+    ("packed-sequence builder is the per-latent version", "action_text_spans_local" in inspect.getsource(_pipe), ""),
+]
+for name, ok, extra in _checks:
+    print(f"[preflight] {name}: {'ok' if ok else 'FAILED'} {extra}", flush=True)
+if not all(ok for _, ok, _ in _checks):
+    sys.exit("[preflight] the loaded diffsynth is not the v2 code; refusing to start training")
+
+_real = Path(__file__).with_name("train.py")
+sys.argv[0] = str(_real)
+runpy.run_path(str(_real), run_name="__main__")
