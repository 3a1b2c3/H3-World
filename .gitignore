# to reproduce the checkout.
DiffSynth-Studio-h3-v2/
DiffSynth-Studio-h3/

# Raw archive extraction, kept locally for reference only.
bundle/

# Video clips (tens of GB) + metadata. Generated by code/abot/build_abot_clips.py.
data/

# Training output: latent cache, LoRA checkpoints, inference videos.
output/

# Runtime and environment caches (HF / torch / triton / inductor, all
# pinned off the root filesystem by env.sh).
.cache/
logs/

# Scratch assets and an internal working copy of code/, both from
# unrelated exploration; not part of this repo's scope.
assets/
code-v2/

# ── Regular ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
*.tmp
*.tmp.*
*.rej
*.orig
.DS_Store

# ── Demo videos: never committed ──────────────────────────────────
